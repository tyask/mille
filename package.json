{
  "name": "mille",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:node": "node scripts/check-node.mjs",
    "lint": "eslint .",
    "audit:dependencies": "npm audit --audit-level=high",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "task:start": "node scripts/task/start.mjs",
    "deps:sync": "node scripts/cloud/dependencies.mjs install",
    "setup:cloud": "node scripts/cloud/setup.mjs",
    "dev:cloud": "node --no-wasm-code-gc --import tsx scripts/cloud/dev.ts",
    "qa:cloud": "node --no-wasm-code-gc --import tsx scripts/cloud/verify.ts",
    "db:setup": "node --import tsx scripts/db/manage.ts migrate",
    "db:seed:test": "node --import tsx scripts/db/manage.ts seed",
    "user:register": "node --import tsx scripts/db/manage.ts register",
    "user:disable": "node --import tsx scripts/db/manage.ts disable"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "1.62.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "overrides": { "postcss": "8.5.25", "sharp": "0.35.5" }
}
