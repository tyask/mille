# 秘密値は安全な環境設定に登録する。ローカル Cloud runner には .env 不要。
AUTH_MODE=google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Production 専用。HOST は接続 URL の正確な hostname。
DATABASE_URL=
MILLE_PRODUCTION_DATABASE_HOST=
MILLE_PRODUCTION_ENVIRONMENT_ID=mille-production

# Preview 専用。本番 DATABASE_URL への fallback はない。
# Vercel Preview のみ AUTH_MODE=test を指定する。
MILLE_PREVIEW_DATABASE_URL=
MILLE_PREVIEW_DATABASE_HOST=
MILLE_PREVIEW_ENVIRONMENT_ID=mille-preview
